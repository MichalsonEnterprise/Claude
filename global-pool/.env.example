# ─────────────────────────────────────────────────────────────────────────────────────────────
# GLOBAL POOL — environment template (DEMO / TESTNET ONLY)
# Copy to .env (git-ignored) and adjust:  cp .env.example .env
# Never commit real secrets. Every value below is a local-dev placeholder.
# Generate dev secrets with:  openssl rand -base64 48   (TOTP key: openssl rand -base64 32)
# ─────────────────────────────────────────────────────────────────────────────────────────────

# ── Runtime & guardrails ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
# Hard server-side kill switch for every real-money path. Must stay false (no mainnet config exists).
REAL_MONEY_ENABLED=false
# Seed + show DEMO data (DEMO badges / DEMO bar everywhere).
DEMO_MODE=true
NEXT_PUBLIC_DEMO_MODE=true

# ── URLs & ports ─────────────────────────────────────────────────────────────────────────────
WEB_PORT=3000
API_PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# WebSocket gateway for live pool / rounds
NEXT_PUBLIC_WS_URL=ws://localhost:4000
# Comma-separated origins allowed by API CORS
CORS_ORIGINS=http://localhost:3000
# Set when the API runs behind a reverse proxy (needed for client IP / geo headers)
TRUST_PROXY=false

# ── Database & cache (local: bash scripts/dev-services.sh start) ────────────────────────────
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/globalpool?schema=public
DATABASE_URL_TEST=postgresql://postgres@127.0.0.1:5432/globalpool_test?schema=public
REDIS_URL=redis://127.0.0.1:6379

# ── API-issued sessions (players after Privy verification; admins) ──────────────────────────
JWT_ACCESS_SECRET=dev-only-change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=dev-only-change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Admin auth is separate from players (email + argon2id password + mandatory TOTP)
ADMIN_JWT_ACCESS_SECRET=dev-only-change-me-admin-access-secret-32-chars
ADMIN_JWT_REFRESH_SECRET=dev-only-change-me-admin-refresh-secret-32-chars
ADMIN_SESSION_TTL=8h
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOCKOUT_MINUTES=15
# 32-byte key (base64) used to encrypt TOTP secrets at rest (AES-256-GCM)
TOTP_ENCRYPTION_KEY=ZGV2LW9ubHktdG90cC1rZXktMzItYnl0ZXMtbG9uZyE=
TOTP_ISSUER=GLOBAL POOL (DEMO)
STEP_UP_MAX_ATTEMPTS=5
STEP_UP_LOCK_MINUTES=15

# ── Player auth: Privy ───────────────────────────────────────────────────────────────────────
# Leave the app id empty (or PRIVY_MOCK=true) to use the offline DEV MOCK: the web uses a mock auth
# provider and the API accepts locally signed dev tokens.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=
NEXT_PUBLIC_PRIVY_MOCK=true
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# ES256 verification key (PEM, \n-escaped) from the Privy dashboard
PRIVY_VERIFICATION_KEY=
PRIVY_MOCK=true
# Signs DEV MOCK tokens (only honoured when PRIVY_MOCK=true and NODE_ENV != production)
PRIVY_MOCK_SIGNING_SECRET=dev-only-change-me-mock-token-secret-32-chars
# WalletConnect (used by Privy wallet login) — placeholder
WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── Compliance ───────────────────────────────────────────────────────────────────────────────
MIN_AGE=18
# ISO 3166-1 alpha-2, comma-separated. PLACEHOLDER list — the restricted-jurisdiction list is a legal decision.
RESTRICTED_COUNTRIES=US,CU,IR,KP,SY
# Header carrying the client country when behind a CDN (e.g. cf-ipcountry, x-vercel-ip-country)
GEO_COUNTRY_HEADER=cf-ipcountry
# Dev only: pretend requests come from this country (ignored in production)
DEV_COUNTRY_OVERRIDE=PT
KYC_PROVIDER=mock
AML_PROVIDER=mock

# ── Chain: Arbitrum Sepolia (chainId 421614) — TESTNET ONLY ─────────────────────────────────
CHAIN_ENV=testnet
NEXT_PUBLIC_CHAIN_ID=421614
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_SEPOLIA_WS_URL=
# Test-USDT (mock ERC-20, 6 decimals) deployed by packages/contracts — empty disables the deposit watcher
TEST_USDT_ADDRESS_ARBITRUM_SEPOLIA=
# GlobalPool round registry contract (packages/contracts)
POOL_CONTRACT_ADDRESS=
# Testnet-only HD xpub for per-user deposit addresses. Empty → the API derives a throwaway dev xpub at runtime.
DEPOSIT_XPUB=
DEPOSIT_CONFIRMATIONS_ARBITRUM=20
DEPOSIT_WATCHER_START_BLOCK=
DEPOSIT_WATCHER_POLL_SECONDS=15
# Testnet throwaway hot-wallet key for broadcasting test withdrawals. Leave empty unless you generated a
# fresh testnet-only key (never a real/mainnet key). Empty → withdrawals stop at "queued".
WITHDRAWAL_SIGNER_PRIVATE_KEY=
# Broadcast queued test-USDT withdrawals with the key above (needs the RPC + TEST_USDT address); false = stay queued
WITHDRAWAL_BROADCASTER_ENABLED=false
WITHDRAWAL_CONFIRMATIONS=20
WITHDRAWAL_TRACK_POLL_SECONDS=15
# 421614 = Arbitrum Sepolia; 31337 = local Anvil devnet (dev / e2e only, refused in production). Signers check
# eth_chainId against this before every signature.
EVM_CHAIN_ID=421614
# Round-mirroring / withdrawal transactions: confirmations before the next step, wait per call, re-broadcast after
CHAIN_WRITE_CONFIRMATIONS=2
CHAIN_TX_WAIT_SECONDS=60
CHAIN_REBROADCAST_SECONDS=120

# ── On-chain mirroring of rounds (GlobalPoolRounds) — TESTNET ONLY ──────────────────────────
# openRound → commitEntries (salted entry Merkle root) → requestDraw (VRF) → recordSettlement. Needs
# RANDOMNESS_PROVIDER=chainlink, the RPC, POOL_CONTRACT_ADDRESS and an operator key. Keys are throwaway testnet
# keys (production keys belong in a KMS/HSM); never commit them.
POOL_ONCHAIN_MIRROR=false
POOL_CONTRACT_START_BLOCK=
POOL_OPERATOR_PRIVATE_KEY=
# Optional separate role keys (default: the operator key)
POOL_SETTLER_PRIVATE_KEY=
POOL_KEEPER_PRIVATE_KEY=
# AES-256-GCM key for per-entry commitment salts (base64, 32 bytes); empty = derived from TOTP_ENCRYPTION_KEY
ENTRY_SALT_ENCRYPTION_KEY=

# ── Randomness: Chainlink VRF v2.5 (placeholders) ────────────────────────────────────────────
# mock | chainlink
RANDOMNESS_PROVIDER=mock
VRF_COORDINATOR=
VRF_KEY_HASH=
VRF_SUBSCRIPTION_ID=
VRF_CALLBACK_GAS_LIMIT=500000
VRF_REQUEST_CONFIRMATIONS=3
# Refund window if VRF is not fulfilled (hours after the request); mirrored rounds re-request instead
VRF_TIMEOUT_HOURS=24
# Confirmations a DrawFulfilled event needs before the word is used for settlement
VRF_FULFILLMENT_CONFIRMATIONS=20

# ── Mail ─────────────────────────────────────────────────────────────────────────────────────
# log = print emails to the API log (default for dev); smtp = send via SMTP (e.g. Mailpit on :1025); disabled
MAIL_TRANSPORT=log
MAIL_FROM="GLOBAL POOL (DEMO) <no-reply@globalpool.example>"
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# ── Rate limiting & jobs ─────────────────────────────────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
BULLMQ_PREFIX=gp
# Share socket.io broadcasts across API replicas through Redis (needed with more than one API process)
SOCKET_IO_REDIS_ADAPTER=false

# ── Observability (optional) ─────────────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── API extras (apps/api) ────────────────────────────────────────────────────────────────────
# Short-lived admin access token (the admin session itself lasts ADMIN_SESSION_TTL)
ADMIN_ACCESS_TTL=15m
# Single-use step-up token lifetime (POST /auth/2fa/challenge)
STEP_UP_TOKEN_TTL=5m
# Admin login attempts per IP per minute; DEV MOCK token issuance per IP per minute
ADMIN_LOGIN_THROTTLE_LIMIT=10
DEV_TOKEN_THROTTLE_LIMIT=30
# Game bet / round writes per IP per minute (DEMO credits; on top of THROTTLE_LIMIT)
GAMES_BET_THROTTLE_LIMIT=600
# Run BullMQ workers + repeatable jobs (deposit watcher, round lifecycle) and the Orbit Rush crash loop
# (100 ms frames, one leader replica via a Redis lease) in this process
JOBS_ENABLED=true
# DEMO convenience: open the next daily round (08:00–20:00 UTC) when none is open
ROUND_AUTO_SCHEDULE=true
# DEMO rounds are a frozen snapshot: closed at their real time but not drawn unless true
DEMO_ROUNDS_AUTO_SETTLE=false
DEPOSIT_WATCHER_MAX_BLOCK_RANGE=5000
# DEMO seed (pnpm --filter @gp/api db:seed): admin password for the seeded DEMO admins (required in production);
# whole-day shift of the DEMO dates (empty = shift so round #1,248 closes at the next 20:00 UTC; 0 = exact snapshot)
ADMIN_SEED_PASSWORD=
DEMO_SEED_SHIFT_DAYS=
