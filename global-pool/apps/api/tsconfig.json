{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@gp/api — NestJS (CommonJS output, decorators + metadata)",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2023"],
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "isolatedModules": false,
    "strictPropertyInitialization": false,
    "outDir": "dist",
    "rootDir": ".",
    "incremental": false,
    "sourceMap": true,
    "declaration": false
  },
  "include": ["src/**/*.ts", "prisma/**/*.ts", "test/**/*.ts", "*.config.ts"],
  "exclude": ["node_modules", "dist"]
}
