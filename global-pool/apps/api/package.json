{
  "name": "@gp/api",
  "version": "0.1.0",
  "private": true,
  "description": "GLOBAL POOL API \u2014 NestJS 11 + Prisma 6 + PostgreSQL + Redis/BullMQ. Hybrid-custody double-entry ledger, Global Pool rounds with verifiable randomness, Privy player auth, separate admin auth. DEMO / testnet only.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "pnpm start:dev",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "build": "pnpm db:generate && nest build -p tsconfig.build.json",
    "typecheck": "pnpm db:generate && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "pnpm db:generate && vitest run --config vitest.config.mts && vitest run --config vitest.e2e.config.mts",
    "test:unit": "vitest run --config vitest.config.mts",
    "test:e2e": "pnpm db:generate && vitest run --config vitest.e2e.config.mts",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:migrate": "node scripts/prisma.mjs migrate dev",
    "db:migrate:deploy": "node scripts/prisma.mjs migrate deploy",
    "db:migrate:test": "node scripts/prisma.mjs migrate reset --force --skip-seed --skip-generate --test-db",
    "db:reset": "node scripts/prisma.mjs migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:prod": "node dist/prisma/seed.js",
    "db:studio": "node scripts/prisma.mjs studio",
    "devnet": "tsx test/devnet.ts"
  },
  "prisma": {
    "seed": "node_modules/.bin/tsx prisma/seed.ts"
  },
  "dependencies": {
    "@gp/contracts": "workspace:*",
    "@gp/shared": "workspace:*",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.12",
    "@nestjs/core": "^11.2.12",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.12",
    "@nestjs/platform-socket.io": "^11.2.12",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/websockets": "^11.2.12",
    "@noble/curves": "1.9.1",
    "@prisma/client": "6.19.3",
    "@privy-io/server-auth": "^1.32.5",
    "@scure/bip32": "1.7.0",
    "@socket.io/redis-adapter": "8.3.0",
    "argon2": "^0.45.2",
    "bullmq": "^5.81.6",
    "decimal.js": "^10.6.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^5.3.2",
    "nestjs-zod": "^5.6.0",
    "nodemailer": "10.4.1",
    "otplib": "^13.6.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "viem": "^2.58.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.12",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.7",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.2.0",
    "prisma": "6.19.3",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^4.1.12"
  }
}
