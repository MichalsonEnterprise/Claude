# syntax=docker/dockerfile:1.7
# GLOBAL POOL API image for hosted test environments (Railway) — DEMO / testnet only.
# Same stages as the `api` target in ./Dockerfile, but self-contained (Railway can't pick a --target) and without
# BuildKit cache mounts. git is installed because @chainlink/contracts (a dev dependency of @gp/contracts) pulls
# @zksync/contracts from a public GitHub repo; SSH URLs are rewritten to HTTPS (no SSH keys in the build).
ARG NODE_VERSION=22

FROM node:${NODE_VERSION}-bookworm-slim AS base
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    CI=true
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates git \
 && rm -rf /var/lib/apt/lists/* \
 && git config --global url."https://github.com/".insteadOf "git@github.com:"
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate
WORKDIR /repo

FROM base AS build
COPY . .
RUN pnpm install --frozen-lockfile --filter "@gp/api..."
RUN pnpm --filter @gp/tokens --filter @gp/shared build && pnpm --filter @gp/contracts build:ts
RUN pnpm --filter @gp/api build

FROM build AS api
ENV NODE_ENV=production \
    API_PORT=4000 \
    REAL_MONEY_ENABLED=false
RUN mkdir -p apps/api/.dev && chown -R node:node apps/api/.dev
EXPOSE 4000
USER node
# SEED_ON_START=true (DEMO test environments only): load the DEMO data into an empty database before the API starts.
# The seed refuses REAL_MONEY_ENABLED=true and non-empty non-DEMO databases; a seed failure never blocks the API.
CMD ["sh", "-c", "pnpm --filter @gp/api run --if-present db:migrate:deploy && if [ \"$SEED_ON_START\" = true ]; then (cd apps/api && node dist/prisma/seed.js && node dist/prisma/seed-history-demo.js && node dist/prisma/seed-admin-ops.js) || echo 'DEMO seed skipped or failed (see above)'; fi; pnpm --filter @gp/api start:prod"]
