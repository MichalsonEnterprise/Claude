# GLOBAL POOL — @gp/contracts deployment parameters (DEMO / testnet only).
# Copy to .env (git-ignored) and fill in. NEVER put a private key in any env file:
# sign with an encrypted keystore (`cast wallet import gp-testnet-deployer --interactive`) and pass
# `--account gp-testnet-deployer` (or `--ledger`) to `forge script ... --broadcast`.

# Public Arbitrum Sepolia RPC (rate-limited; use a provider URL for real work)
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
# Only needed for `--verify` on Arbiscan
ARBISCAN_API_KEY=

# Chainlink VRF v2.5 on Arbitrum Sepolia — VERIFY BEFORE USE (README "Arbitrum Sepolia VRF v2.5")
VRF_COORDINATOR=0x5CE8D5A2BC84beb22a398CCA51996F7930313D61
VRF_KEY_HASH=0x1770bdc7eec7771f7ba4ffd640f34260d7f095b79c92d34a5b2551d6f6cfd2be
# Create + fund (LINK) at https://vrf.chain.link (Arbitrum Sepolia); the id is a large uint256
VRF_SUBSCRIPTION_ID=
VRF_CALLBACK_GAS_LIMIT=250000
VRF_REQUEST_CONFIRMATIONS=3
# true = the deployer owns the subscription and adds the new contract as a consumer in the same run
VRF_ADD_CONSUMER=false
# true = allow a coordinator/key hash that differs from the documented Arbitrum Sepolia values
VRF_ALLOW_UNLISTED=false

# Role holders (use multisig / service addresses; testnet throwaway addresses for DEMO)
GP_ADMIN_ADDRESS=
GP_OPERATOR_ADDRESS=
GP_SETTLER_ADDRESS=
GP_PAUSER_ADDRESS=
