{
  "name": "@gp/tokens",
  "version": "0.1.0",
  "private": true,
  "description": "GLOBAL POOL design tokens (mirror of the Figma variables) → CSS custom properties, Tailwind CSS v4 @theme, text-style classes and a typed JS export.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./tokens.css": "./dist/tokens.css",
    "./theme.css": "./dist/theme.css",
    "./text-styles.css": "./dist/text-styles.css",
    "./tokens.json": "./tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "tokens.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node --watch-path=tokens.json --watch-path=scripts scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "eslint": "^9.39.5",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
