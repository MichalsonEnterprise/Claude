{
  "name": "global-pool",
  "private": true,
  "version": "0.1.0",
  "description": "GLOBAL POOL — Web3 global jackpot & crypto gaming platform (monorepo: web, api, contracts, shared). DEMO / testnet only — real-money operation disabled.",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev:services": "bash scripts/dev-services.sh start",
    "dev:web": "pnpm --filter @gp/web dev",
    "dev:api": "pnpm --filter @gp/api start:dev",
    "build:packages": "pnpm --filter @gp/tokens --filter @gp/shared build && pnpm --filter @gp/contracts build:ts",
    "build": "pnpm -r build",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.7",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.9",
    "globals": "^16.5.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0"
  },
  "engines": {
    "node": ">=22"
  }
}
