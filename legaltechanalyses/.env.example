# Public URL of the site (used for NOWPayments success/cancel/IPN URLs).
SITE_URL=https://your-domain.com

# NOWPayments — Dashboard → Settings → Payments → API keys / IPN secret
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Set to "true" to use https://api-sandbox.nowpayments.io with a sandbox API key
NOWPAYMENTS_SANDBOX=false

# Optional: email notifications via Resend (https://resend.com) when a payment is finished.
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend, e.g. "LegalTechAnalyses <orders@your-domain.com>"
EMAIL_FROM=
# Where new paid orders are reported (your team inbox)
ORDER_NOTIFY_EMAIL=
