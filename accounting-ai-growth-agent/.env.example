# ============================================================================
# accounting-ai-growth-agent — environment configuration
# Copy to .env and fill in. Never commit the real .env file.
# ============================================================================

# --- Core service ---------------------------------------------------------
PORT=8090
TIMEZONE=Europe/Warsaw
NODE_ENV=production

# Postgres used by THIS service (separate from Postiz's own database)
DATABASE_URL=postgresql://growth_agent:growth_agent@localhost:5433/growth_agent

# --- Autopilot --------------------------------------------------------------
# OFF | DRAFT | FULL_AUTO  (default DRAFT — nothing publishes without approval)
AUTOPILOT_MODE=DRAFT

# When true, the pipeline runs end-to-end but the final Postiz publish step
# only logs "WOULD_PUBLISH" with the full payload instead of calling Postiz.
DRY_RUN=true

# --- LLM provider abstraction ------------------------------------------------
# anthropic | openai | mock
AI_PROVIDER=mock

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Per-stage model overrides (any string; provider-specific model ids).
# Leave blank to use the provider's built-in default.
AI_RESEARCH_MODEL=
AI_WRITER_MODEL=
AI_VERIFIER_MODEL=

# --- Postiz (social publishing engine) --------------------------------------
# Base URL of the Postiz PUBLIC API, e.g. http://localhost:4007/public/v1
# for a self-hosted instance, or https://api.postiz.com/public/v1 for cloud.
POSTIZ_BASE_URL=http://localhost:4007/public/v1
POSTIZ_API_KEY=

# When true (or when POSTIZ_API_KEY is empty), PostizClient never makes real
# HTTP calls — it returns realistic fake responses so the pipeline can be
# fully exercised without a running Postiz instance.
POSTIZ_MOCK=true

# --- Research ---------------------------------------------------------------
RESEARCH_INTERVAL_HOURS=4
TOPIC_MIN_SCORE=65
DUPLICATE_WINDOW_DAYS=60

# --- Publishing frequency (posts / week, per platform) -----------------------
POSTS_PER_WEEK_LINKEDIN=5
POSTS_PER_WEEK_X=7
POSTS_PER_WEEK_FACEBOOK=4
POSTS_PER_WEEK_INSTAGRAM=4
POSTS_PER_WEEK_TIKTOK=3

# Comma-separated list of platforms actually enabled.
ENABLED_PLATFORMS=linkedin,linkedin-page,x,facebook,instagram,tiktok

# Preferred publishing hour window (24h, local TIMEZONE)
PUBLISHING_HOUR_START=8
PUBLISHING_HOUR_END=18

# --- Content strategy weekly mix (must sum to ~100) --------------------------
MIX_EDUCATION=30
MIX_NEWS=25
MIX_PRODUCT=20
MIX_PROBLEMS=10
MIX_CASE_STUDY=10
MIX_DIRECT_MARKETING=5

# --- Panel / API auth (very light, single-operator system) -------------------
# If set, all /api routes except /health require this exact header:
# x-panel-token: <value>
PANEL_TOKEN=
